# ============================================================================
#  MYKARAKIDS — ENVIRONMENT VARIABLES
#  Copy this file to `.env.local` and fill in your own keys.
#  NEVER commit .env.local. Every buyer supplies their OWN keys below.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (database + auth + storage)
#   Create a project at https://supabase.com → Project Settings → API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only. Bypasses RLS for trusted asset-generation routes. Keep secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----------------------------------------------------------------------------
# AI providers (Google AI Studio / Gemini API)
# ----------------------------------------------------------------------------

# Google AI Studio API key — powers Gemini text, Gemini image, and Gemini TTS.
#   Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-google-ai-studio-api-key"
# Optional pool for legitimate keys/projects only. The app round-robins keys
# and fails over to the next key on quota/rate-limit responses.
# If this has 3+ keys and no role-specific keys are set, keys are split by role:
#   key 1/4/7... = image, key 2/5/8... = story, key 3/6/9... = audio.
# GEMINI_API_KEYS="key-one,key-two,key-three"
# GEMINI_API_KEYS_SPLIT_BY_PURPOSE="true"
# Prefer explicit role pools when you want full control:
# GEMINI_IMAGE_API_KEYS="image-key-one,image-key-two"
# GEMINI_STORY_API_KEYS="story-key-one,story-key-two"
# GEMINI_AUDIO_API_KEYS="audio-key-one,audio-key-two"
# Vercel-friendly numbered variants are also supported:
# GEMINI_IMAGE_API_KEY_1="image-key-one"
# GEMINI_IMAGE_API_KEY_2="image-key-two"
# GEMINI_STORY_API_KEY_1="story-key-one"
# GEMINI_AUDIO_API_KEY_1="audio-key-one"
# Also accepted by the app if you already use this common Gemini env name:
# GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-studio-api-key"
# GOOGLE_GENERATIVE_AI_API_KEYS="key-one,key-two"

# ----------------------------------------------------------------------------
# Provider selection (OPTIONAL — override the defaults in config/providers.ts)
# ----------------------------------------------------------------------------
# Google AI Studio Interactions API overrides are rarely needed.
# GOOGLE_AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# GOOGLE_AI_HTTP_TIMEOUT_MS="55000"
# GOOGLE_AI_MAX_RETRIES="2"
# GOOGLE_AI_MAX_KEY_ROUNDS="3"
# GOOGLE_AI_MAX_KEY_WAIT_MS="25000"
# GOOGLE_AI_BACKOFF_JITTER="0.2"
# GOOGLE_AI_RATE_LIMIT_COOLDOWN_MS="12000"
# GOOGLE_AI_AUDIO_HTTP_TIMEOUT_MS="28000"
# GOOGLE_AI_AUDIO_MAX_KEY_WAIT_MS="8000"
# GOOGLE_AI_AUDIO_FAIL_FAST_ON_COOLDOWN="true"
# GOOGLE_AI_AUDIO_FAIL_FAST_ON_TRANSIENT="true"
# GOOGLE_AI_IMAGE_MIN_INTERVAL_MS="6000"
# GOOGLE_AI_STORY_MIN_INTERVAL_MS="1500"
# GOOGLE_AI_AUDIO_MIN_INTERVAL_MS="3000"
# NEXT_PUBLIC_GENERATE_IMAGE_STEP_DELAY_MS="2500"
# How many times the browser retries a scene illustration while every image key
# is on quota cooldown before accepting a placeholder (which is regenerated on
# the next visit once quota recovers).
# NEXT_PUBLIC_GENERATE_IMAGE_RETRY_LIMIT="6"
# NEXT_PUBLIC_GENERATE_IMAGE_RETRY_DELAY_MS="9000"
# NEXT_PUBLIC_GENERATE_AUDIO_STEP_DELAY_MS="1500"
# NEXT_PUBLIC_GENERATE_AUDIO_RETRY_LIMIT="10"
# NEXT_PUBLIC_GENERATE_AUDIO_RETRY_DELAY_MS="8000"
# GOOGLE_AI_API_REVISION="2026-05-20"

# STORY_PROVIDER="gemini"
# STORY_MODEL="gemini-3.5-flash"
# IMAGE_PROVIDER="gemini"
# IMAGE_MODEL="gemini-3.1-flash-lite-image"
# IMAGE_ASPECT_RATIO="4:3"
# Output resolution tier: "1K" (~1080px, cheapest/free-friendly), "2K", or "4K".
# Keep this at 1K to stay low-cost — 2K/4K are billed higher per image.
# IMAGE_RESOLUTION="1K"
# TTS_PROVIDER="google"
# TTS_MODEL="gemini-3.1-flash-tts-preview"
# TTS_VOICE="Kore"
# TTS_LANGUAGE_CODE="id"
# TTS_SPEAKING_RATE="0.95"
# TTS_STABILITY="0.5"
# TTS_SIMILARITY_BOOST="0.75"
# TTS_STYLE="0"

# ----------------------------------------------------------------------------
# Free Nano Banana illustrations (KIE.ai) — recommended when Gemini image quota
# runs out. New KIE accounts get free credits: https://kie.ai/api-key
# ----------------------------------------------------------------------------
# Just add a KIE key and the app automatically uses KIE Nano Banana as a FREE
# overflow whenever the Gemini image call hits a quota/rate limit — so scenes
# still get real art instead of a placeholder.
# KIE_API_KEY="your-kie-api-key"
# Disable the automatic overflow with "false" (default is on when KIE_API_KEY is set):
# IMAGE_KIE_FALLBACK="true"
# Which KIE Nano Banana model to use for overflow. Options: google/nano-banana
# (free-friendly), google/nano-banana-2, google/nano-banana-2-lite, google/nano-banana-pro
# IMAGE_FALLBACK_MODEL="google/nano-banana"
#
# To make KIE Nano Banana the PRIMARY illustrator instead of Gemini, set:
# IMAGE_PROVIDER="kie"
# IMAGE_MODEL="google/nano-banana"

# Optional legacy KIE stack, only if you set providers back to KIE/ElevenLabs.
# KIE_GEMINI_CHAT_ENDPOINT="https://api.kie.ai/gemini-3-flash/v1/chat/completions"
# KIE_HTTP_TIMEOUT_MS="60000"
# KIE_TASK_TIMEOUT_MS="55000"
# KIE_TASK_POLL_INTERVAL_MS="2000"
# KIE_MAX_RETRIES="2"
